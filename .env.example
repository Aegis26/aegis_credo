# Core runtime (required)
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-base64-of-exactly-32-random-bytes
PUBLIC_APP_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY=1

# Platform operator (required only when MASTER ADMIN is enabled)
MASTER_ADMIN_EMAIL=admin@example.com

# Anthropic statement extraction
ANTHROPIC_API_KEY=

# Plaid (all three are required when Plaid bank linking is enabled)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional application behavior
ALLOW_PUBLIC_SIGNUP=false
LOG_LEVEL=info
# AUTH_RATE_LIMIT_MAX=50
# API_RATE_LIMIT_MAX=1000
# HEAVY_RATE_LIMIT_MAX=60
# PLATFORM_RESET_RATE_LIMIT_MAX=5

# Optional frontend subpath override; defaults to "/".
# BASE_PATH=/